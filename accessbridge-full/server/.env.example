PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local JSON storage is the default. Set to mysql only when a MySQL database is configured.
STORAGE=json

# Azure AI Speech neural voices for Hindi and Telugu (keep the key private in server/.env).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# MySQL connection settings — change these to match your local MySQL setup
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=accessbridge
